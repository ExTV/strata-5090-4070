{
  "exe": "build/strata",
  "args": [
    "--pack",
    "packs/unsloth-ud-iq3_xxs-v31",
    "--native",
    "@MODELS@/UD-IQ3_XXS/Qwen3.8-Flash-Next-UD-IQ3_XXS-00001-of-00004.gguf",
    "--ple-gguf",
    "@MODELS@/ple-q8_0.gguf",
    "--expert-profile",
    "data/expert-profile.bin",
    "--expert-cache",
    "auto",
    "--mmap-experts",
    "--prefill",
    "4096",
    "--spec",
    "4",
    "--spec-min-p",
    "0.8",
    "--mtp",
    "mtp/rt",
    "--mtp-hnorm",
    "stream",
    "--max-context",
    "262144",
    "--kv",
    "int8",
    "--kv-resident",
    "32768",
    "--kv-resident-later",
    "0",
    "--vision",
    "--vram-reserve-mib",
    "700",
    "--prefill-main",
    "--conversation-cache-mib",
    "0",
    "--resident-experts",
    "--vram-reserve-later-mib",
    "420",
    "--short-read",
    "128",
    "--trim-stage-weights",
    "--pipeline-windows",
    "2",
    "--adapt-async",
    "1",
    "--control-vector-scaled",
    "@MODELS@/Huihui-Qwen3.8-Flash-Next-refusal-direction-r.gguf:1.0",
    "--control-vector-layer-range",
    "4",
    "44",
    "--cvec-mode",
    "project",
    "--cvec-dir",
    "per-layer",
    "--prefill-main-small",
    "512",
    "--prefill-main-small-max",
    "262144",
    "--lookup-chain",
    "4",
    "--resident-budget-gib",
    "14.7",
    "--aux-cpus",
    "auto",
    "--host-core",
    "sibling"
  ],
  "gpu": [
    0,
    1
  ],
  "layer_split": "39",
  "sampling": {
    "temperature": 1.0,
    "top_p": 0.95,
    "top_k": 20,
    "min_p": 0.0,
    "presence_penalty": 0.0
  },
  "cwd": ".",
  "tokenizer": "packs/unsloth-ud-iq3_xxs-v31/tokenizer-sharp",
  "model_name": "qwen3.8-flash-next",
  "log": "strata-flash-next-ud-iq3xxs-262k.log",
  "host": "127.0.0.1",
  "port": 8888,
  "vision": {
    "exe": "build-vision/bin/strata-vision",
    "mmproj": "@MODELS@/mmproj-Qwen3.8-Flash-Next-BF16.gguf",
    "model": "@MODELS@/UD-IQ3_XXS/Qwen3.8-Flash-Next-UD-IQ3_XXS-00001-of-00004.gguf",
    "gpu": true,
    "max_tokens": 1024,
    "cuda_device": 1
  },
  "env": {
    "STRATA_ROUTE_TAIL_SKIP": "0",
    "STRATA_BLOB_PREAD": "1",
    "STRATA_PF_FUSED": "1",
    "STRATA_RESIDENT_LEND": "1",
    "STRATA_RESIDENT_HEADROOM_GIB": "3",
    "STRATA_PL_PLE_PREFETCH": "1",
    "STRATA_PL_PLE_LATE": "1",
    "STRATA_PL_EARLY_CHAIN": "1",
    "MALLOC_MMAP_THRESHOLD_": "1048576",
    "MALLOC_ARENA_MAX": "4",
    "STRATA_PM_MTP_BATCH": "1",
    "STRATA_RAM_ADAPT": "256",
    "STRATA_GR_NORM_FAST": "1",
    "STRATA_SCORES_HALVE": "1",
    "STRATA_TOPK_SPLIT": "1",
    "STRATA_QIL": "1",
    "STRATA_SIDE_MIXER": "2",
    "STRATA_ATTN_DAILY": "1",
    "STRATA_GU_SWIGLU": "1",
    "STRATA_GR_UP75": "1",
    "STRATA_GR_DOWN_TG": "1",
    "STRATA_GR_V3": "1",
    "STRATA_FUSE_HEAD_GR": "1",
    "STRATA_IO_THREADS": "64",
    "STRATA_LFUSE": "1",
    "STRATA_UNBUFFERED_LOAD": "1",
    "STRATA_HC_Q8": "0"
  },
  "vram_reserve": "as_given",
  "gpu_order": "as_given",
  "fit_max_tokens": true,
  "expert_profile_save": "expert-profile-learned-udiq3.bin"
}
