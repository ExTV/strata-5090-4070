{
 "exe": "build/strata",
 "args": [
  "--pack", "packs/gsq-iq3_s",
  "--native", "@MODELS@/IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf",
  "--ple-gguf", "@MODELS@/ple-fp8.gguf",
  "--expert-profile", "data/expert-profile.bin",
  "--expert-cache", "auto",
  "--mmap-experts",
  "--prefill", "auto:16384",
  "--spec", "4",
  "--spec-min-p", "0.8",
  "--mtp", "mtp/rt",
  "--mtp-hnorm", "stream",
  "--max-context", "262144",
  "--kv", "int8",
  "--kv-resident", "32768",
  "--kv-resident-later", "0",
  "--vision",
  "--vram-reserve-mib", "700",
  "--vram-reserve-later-mib", "420",
  "--resident-experts",
  "--prefill-main",
  "--prefill-main-small", "512",
  "--prefill-main-small-max", "262144",
  "--conversation-cache-mib", "1024",
  "--conversation-cache-slots", "8",
  "--conversation-cache-min-free-mib", "1024",
  "--conversation-cache-park-gain", "4096",
  "--prefix-cache-dir", "prefix-cache",
  "--prefix-cache-ram-mib", "512",
  "--conversation-spill-dir", "conversation-spill",
  "--no-conversation-spill-idle",
  "--conversation-cache-min-tokens", "1024",
  "--short-read", "128",
  "--trim-stage-weights",
  "--pipeline-windows", "2",
  "--adapt-async", "1",
  "--control-vector-scaled", "@MODELS@/Huihui-Qwen3.8-Flash-Next-refusal-direction-r.gguf:1.0",
  "--control-vector-layer-range", "4", "44",
  "--cvec-mode", "project",
  "--cvec-dir", "per-layer"
 ],
 "fit_max_tokens": true,
 "expert_profile_save": "expert-profile-learned.bin",
 "gpu": [0, 1],
 "layer_split": "39",
 "gpu_order": "as_given",
 "vram_reserve": "as_given",
 "sampling": {"temperature": 1.0, "top_p": 0.95, "top_k": 20, "min_p": 0.0, "presence_penalty": 0.0},
 "env": {
  "STRATA_BLOB_PREAD": "1", "STRATA_PF_FUSED": "1", "STRATA_RESIDENT_LEND": "1", "STRATA_RESIDENT_HEADROOM_GIB": "4",
  "STRATA_PL_PLE_PREFETCH": "1", "STRATA_PL_PLE_LATE": "1", "STRATA_PL_EARLY_CHAIN": "1",
  "STRATA_PM_MTP_BATCH": "1", "STRATA_ROUTE_TAIL_SKIP": "0", "STRATA_RAM_ADAPT": "256",
  "MALLOC_MMAP_THRESHOLD_": "1048576", "MALLOC_ARENA_MAX": "4"
 },
 "cwd": ".",
 "tokenizer": "packs/gsq-iq3_s/tokenizer-sharp",
 "model_name": "qwen3.8-flash-next",
 "log": "strata-flash-next-262k.log",
 "host": "127.0.0.1",
 "port": 8888,
 "vision": {
  "exe": "build-vision/bin/strata-vision",
  "mmproj": "@MODELS@/mmproj-Qwen3.8-Flash-Next-BF16.gguf",
  "model": "@MODELS@/IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf",
  "gpu": true,
  "max_tokens": 1024,
  "cuda_device": 1
 }
}
