{
 "exe": "build/strata",
 "args": [
  "--pack", "packs/gsq-iq3_xxs",
  "--native", "@MODELS@/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00001-of-00002.gguf",
  "--ple-gguf", "@MODELS@/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00002-of-00002.gguf",
  "--expert-profile", "data/expert-profile.bin",
  "--expert-cache", "auto",
  "--mmap-experts",
  "--prefill", "auto:32768",
  "--spec", "4",
  "--spec-min-p", "0.8",
  "--mtp", "mtp/rt",
  "--max-context", "262144",
  "--kv", "int8",
  "--kv-resident", "32768",
  "--vision",
  "--vram-reserve-mib", "700",
  "--vram-reserve-later-mib", "700",
  "--resident-experts",
  "--prefill-main",
  "--conversation-cache-mib", "6144",
  "--conversation-cache-slots", "8",
  "--short-read", "768",
  "--trim-stage-weights",
  "--pipeline-windows", "2",
  "--adapt-async", "1"
 ],
 "fit_max_tokens": true,
 "gpu": [0, 1],
 "layer_split": "36",
 "gpu_order": "as_given",
 "vram_reserve": "as_given",
 "sampling": {"temperature": 0.6, "top_p": 0.95, "top_k": 20},
 "format_fixes": "stranded-call",
 "env": {
  "STRATA_BLOB_PREAD": "1", "STRATA_PF_FUSED": "1", "STRATA_RESIDENT_LEND": "1", "STRATA_RESIDENT_HEADROOM_GIB": "14",
  "STRATA_PL_PLE_PREFETCH": "1", "STRATA_PL_PLE_LATE": "1", "STRATA_PL_EARLY_CHAIN": "1",
  "STRATA_SPLIT_SMALL_OWN": "3072",
  "MALLOC_MMAP_THRESHOLD_": "1048576", "MALLOC_ARENA_MAX": "4"
 },
 "cwd": ".",
 "tokenizer": "packs/gsq-iq3_xxs/tokenizer",
 "model_name": "qwen3.8-flash-next",
 "log": "strata-flash-next-262k.log",
 "host": "127.0.0.1",
 "port": 8888,
 "vision": {
  "exe": "build-vision/bin/strata-vision",
  "mmproj": "@MODELS@/mmproj-Qwen3.8-Flash-Next-BF16.gguf",
  "model": "@MODELS@/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00001-of-00002.gguf",
  "gpu": true,
  "max_tokens": 1024
 }
}
