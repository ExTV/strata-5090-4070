+
+bool MtpDrafter::kv_weights_on(int device, KvWeights& w, std::string& err) {
+    // the ten tensors Prefill::draft_kv reads, in the order of KvCopy::off
+    static const char* const kNames[10] = {
+        "pre_fc_norm_embedding.weight", "pre_fc_norm_hidden.weight", "attn_hyper_connection.hc_norm.weight",
+        "self_attn.k_norm.weight", "fc_embedding.weight", "fc_hidden.weight", "self_attn.k_proj.weight",
+        "self_attn.v_proj.weight", "attn_hyper_connection.input_mix_weight_down.weight",
+        "attn_hyper_connection.input_mix_weight_up.weight"};
+    static const char* const kKinds[10] = {"f32", "f32", "f32", "f32", "q8_0", "q8_0", "q8_0", "q8_0", "bf16", "bf16"};
+    auto assign = [&](const uint8_t* base, const uint64_t* off, const bool* have) {
+        auto p = [&](int i) -> const void* { return have[i] ? base + off[i] : nullptr; };
+        w.ne = (const float*) p(0); w.nh = (const float*) p(1); w.hn = (const float*) p(2); w.kn = (const float*) p(3);
+        w.fe = p(4); w.fh = p(5); w.k = p(6); w.v = p(7);
+        w.dn = (const uint16_t*) p(8); w.up = (const uint16_t*) p(9);
+    };
+    const Tensor* found[10] = {};
+    bool have[10] = {};
+    for (int i = 0; i < 10; ++i)
+        for (const auto& t : tensors_)
+            if (t.name == kNames[i] && t.kind == kKinds[i]) { found[i] = &t; have[i] = true; break; }
+    if (device < 0 || device == device_) {
+        uint64_t off[10] = {};
+        for (int i = 0; i < 10; ++i) if (have[i]) off[i] = found[i]->off;
+        assign(dense_, off, have);
+        return true;
+    }
+    for (const KvCopy& c : kv_copies_)
+        if (c.device == device) { assign(c.blob, c.off, have); return true; }
+    // a copy for this device: the tensors' bytes from dense.bin, contiguous
+    KvCopy c;
+    c.device = device;
+    uint64_t total = 0;
+    for (int i = 0; i < 10; ++i) if (have[i]) { c.off[i] = total; total += (found[i]->bytes + 255) & ~(uint64_t) 255; }
+    std::vector<uint8_t> blob((size_t) total);
+    FILE* f = std::fopen((rt_dir_ + "/dense.bin").c_str(), "rb");
+    if (f == nullptr) { err = "mtp: cannot open dense.bin for the main device's copy"; return false; }
+    for (int i = 0; i < 10; ++i) {
+        if (!have[i]) continue;
+        if (STRATA_FILE_SEEK64(f, (long long) found[i]->off, SEEK_SET) != 0 ||
+            std::fread(blob.data() + c.off[i], 1, (size_t) found[i]->bytes, f) != (size_t) found[i]->bytes) {
+            std::fclose(f);
+            err = "mtp: dense.bin is short of " + std::string(kNames[i]);
+            return false;
+        }
+    }
+    std::fclose(f);
+    const OnDevice on(device);
+    if (cudaMalloc((void**) &c.blob, (size_t) total) != cudaSuccess) {
+        err = "mtp: the main device has no room for the draft layer's K/V projections (" + std::to_string(total >> 20) + " MiB)";
+        return false;
+    }
+    if (cudaMemcpy(c.blob, blob.data(), (size_t) total, cudaMemcpyHostToDevice) != cudaSuccess) {
+        cudaFree(c.blob);
+        err = "mtp: the K/V projections' upload to the main device failed";
+        return false;
+    }
+    kv_copies_.push_back(c);
+    assign(c.blob, c.off, have);
+    return true;
+}
