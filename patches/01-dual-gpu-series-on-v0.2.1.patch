+                }
+                if (ok && b1 > b0) {
+                    const int64_t p0 = std::min<int64_t>(cell0 / sh.idx_block, sq.idx_pooled_rows);
+                    const int64_t p1 = std::min<int64_t>((cell1 + sh.idx_block - 1) / sh.idx_block, sq.idx_pooled_rows);
+                    if (p1 > p0)
+                        ok = hop(sq.idx_pooled + (size_t) p0 * sh.idx_dim, dq.idx_pooled + (size_t) p0 * sh.idx_dim,
+                                 (uint64_t) (p1 - p0) * sh.idx_dim * 4, "indexer rows");
+                }
