+                    const QsaState& str = sq.kv_mode == 1 ? sq : dq;
+                    struct Arr { const void* dev; const void* host; uint64_t per_row; };
+                    std::vector<Arr> arrs;
+                    if (sq.kv_hybrid)
+                        arrs = {{res.k_q, str.host.k_q, (uint64_t) sh.head_dim}, {res.k_scale, str.host.k_scale, sc * 2},
+                                {res.v_q4, str.host.v_q4, q4_row}};
+                    else if (sq.kv_q4)
