+                        }
+                    }
+                    if (!ok) break;
+                } else if (b1 > b0 && sq.kv_mode == 1 && sq.host.present()) {
+                    const uint64_t r0 = (uint64_t) b0 * brows, nr = (uint64_t) (b1 - b0) * brows;
+                    if (sq.kv_q4) {
