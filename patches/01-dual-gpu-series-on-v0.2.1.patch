+        if (bytes == 0) return true;
+        if (cudaError_t e = cudaMemcpyPeer(dstp, dst_dev, srcp, src_dev, (size_t) bytes); e != cudaSuccess) {
+            err = std::string("session_copy_layers: peer ") + what + ": " + cudaGetErrorString(e);
+            return false;
+        }
