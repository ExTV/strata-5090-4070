+    sh.n_head = g.n_head;
+    sh.n_head_kv = g.n_head_kv;
+    sh.head_dim = g.head_dim;
+    sh.idx_n_head = g.idx_q_heads;
+    sh.idx_dim = g.idx_key_dim;
+    const uint64_t gdn_row = gdn_state_floats(g) * 4;
+    bool ok = true;
+    int64_t gdn_ord = 0, qsa_ord = 0;
+    for (int64_t l = 0; l < layer_end && ok; ++l) {
+        const bool mine = l >= layer_begin;
+        if (is_qsa_layer(g, l)) {
+            if (mine) {
+                const QsaState& sq = src.qsa_states[qsa_ord];
+                QsaState& dq = dst.qsa_states[qsa_ord];
+                // one side may stream (mode 1, the host copy is its K/V) while the other holds the whole pool in VRAM
+                // (mode 0, --kv-resident-later 0 on a later stage): both are the identity row layout, so a block range
+                // is the same byte range of every array on either side
+                const bool mixed = sq.kv_mode != dq.kv_mode;
+                if (sq.n_pages != dq.n_pages || sq.idx_pooled_rows != dq.idx_pooled_rows ||
+                    sq.kv_int8 != dq.kv_int8 || sq.kv_q4 != dq.kv_q4 || sq.kv_hybrid != dq.kv_hybrid ||
+                    (!mixed && sq.n_slots != dq.n_slots) ||
+                    (mixed && !((sq.kv_mode == 1 && dq.kv_mode == 0) || (sq.kv_mode == 0 && dq.kv_mode == 1)))) {
+                    err = "session_copy_layers: QSA layouts differ between the sessions";
+                    ok = false;
+                    break;
+                }
+                // the block range [b0, b1): host K/V and the pooled indexer rows (one row per page)
+                const int64_t b0 = std::min<int64_t>(cell0 / sh.page_size, sq.n_pages);
+                const int64_t b1 = std::min<int64_t>((cell1 + sh.page_size - 1) / sh.page_size, sq.n_pages);
+                const uint64_t brows = (uint64_t) sh.n_head_kv * sh.page_size;   // K/V rows per block
+                const uint64_t q4_row = kernels::kv_q4_bytes_per_head((int) sh.head_dim);
+                const uint64_t sc = sh.head_dim / kernels::KV_Q8_GROUP;
+                if (b1 > b0 && mixed) {
+                    // the streamed side's host copy is pinned and device-mapped (UVA), so one cudaMemcpy per array
+                    // moves the range in either direction; the resident side's page table is the identity
