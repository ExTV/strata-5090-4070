+                    else
+                        arrs = {{res.k_pool, str.host.k_pool, (uint64_t) sh.head_dim * 2},
+                                {res.v_pool, str.host.v_pool, (uint64_t) sh.head_dim * 2}};
+                    const uint64_t r0 = (uint64_t) b0 * brows, nr = (uint64_t) (b1 - b0) * brows;
+                    cudaSetDevice(sq.kv_mode == 0 ? src_dev : dst_dev);   // the resident pool's device
