+bool session_copy_layers(SessionState& dst, const SessionState& src, const ModelGeometry& g,
+                         int64_t layer_begin, int64_t layer_end, int src_dev, int dst_dev,
+                         std::string& err, int64_t cell0, int64_t cell1) {
+    // Local port of Strata PR #269 onto the 0.1.33 layer-range carve.  Each session finds its pieces through its own
+    // ordinals and QsaState pointers (the raw block layouts differ).  Streamed K/V: the host copy is the identity
+    // layout [block][kv_head][page][head_dim] (kv_stream.hpp), so a block range is a contiguous run of every array;
+    // VRAM slots are never copied - the receiver's map is evicted from the first rewritten block and its readers
+    // resolve from the host copy, as they do after any miss.  Works in both directions.
+    if (layer_begin >= layer_end) return true;
+    if (cell0 < 0) cell0 = 0;
+    if (cell1 < cell0) cell1 = cell0;
