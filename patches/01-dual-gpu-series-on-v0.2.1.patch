+    c.requests = s.requests;
+    c.cache_hits = s.cache_hits;
+    c.attached = s.attached_rows;
+    c.reads = s.reads;
+    c.prefetch_rows = s.prefetch_rows;
+    c.prefetch_skipped = s.prefetch_skipped;
+    c.prefetch_reads = s.prefetch_reads;
+    c.wait_us = s.wait_us;
+    return c;
+}
