index 00000000..3a2c2278
--- /dev/null
+++ b/serve/test_skipped_closer.py
@@ -0,0 +1,159 @@
+"""A value that holds a nested `<parameter=X>...</parameter>` pair, after which the model skips the value's own
+`</parameter>` and goes straight to `</function>` or the next parameter.  Qwen3.8-Flash-Next did this in 7 of 15
+edits of a file that documents the call format (2026-10-15, raw engine output):
+
+    <parameter=new_string>
+    <parameter=limit>25</parameter>
+    </function>
+    </tool_call>
+
+The parser read new_string as `<parameter=limit>25`.  A `</parameter>` that matches a `<parameter=` opened inside
+the value is the value's text; the value ends at the first unmatched one, or, when the model skipped it, right before
+the `</function>` (followed by `</tool_call>`) or the next declared parameter.
+
+Run: .venv/bin/python -m unittest serve.test_skipped_closer
+"""
+import json
+import sys
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+from serve.frontend import OutputParser, parse_tool_call  # noqa: E402
+
+TOOLS = [
+    {"name": "read_file", "parameters": {"properties": {"path": {"type": "string"}, "offset": {"type": "integer"},
+                                                        "limit": {"type": "integer"}}}},
+    {"name": "edit_file", "parameters": {"properties": {"path": {"type": "string"}, "old_string": {"type": "string"},
+                                                        "new_string": {"type": "string"}}}},
+    {"name": "bash", "parameters": {"properties": {"command": {"type": "string"}, "timeout": {"type": "integer"}}}},
+]
+EDIT_SKIPPED = ("<tool_call>\n<function=edit_file>\n<parameter=path>\ntemplates/chat.jinja\n</parameter>\n"
+                "<parameter=old_string>\n<parameter=limit>40</parameter>\n</parameter>\n"
+                "<parameter=new_string>\n<parameter=limit>25</parameter>\n</function>\n</tool_call>")
+BASH = ("<tool_call>\n<function=bash>\n<parameter=command>\npytest -q tests/test_template.py\n</parameter>\n"
+        "<parameter=timeout>\n120\n</parameter>\n</function>\n</tool_call>")
+EDIT_ARGS = {"path": "templates/chat.jinja", "old_string": "<parameter=limit>40</parameter>",
+             "new_string": "<parameter=limit>25</parameter>"}
+BASH_ARGS = {"command": "pytest -q tests/test_template.py", "timeout": 120}
+
+
+def run(text, *, stream_tools=True, step=3, recover=False):
+    p = OutputParser(thinking=True, tools=TOOLS, stream_tools=stream_tools, recover=recover)
+    evs = []
+    for i in range(0, len(text), step):
+        evs += p.feed(text[i:i + step])
+    evs += p.finish("stop")
+    return evs
+
+
+def calls(evs):
+    return [(e.call.name, e.call.arguments) for e in evs if e.kind == "tool_call"]
+
+
+def streamed(evs):
+    """The streamed arguments of each announced call, decoded."""
+    by_call = {}
+    for e in evs:
+        if e.kind == "tool_args":
+            by_call.setdefault(id(e.call), []).append(e.text)
+    return [json.loads("".join(parts)) for parts in by_call.values()]
+
+
+class SkippedCloserBeforeFunctionEnd(unittest.TestCase):
+    def test_parse_tool_call_keeps_the_nested_pair(self):
+        body = EDIT_SKIPPED[len("<tool_call>\n"):-len("\n</tool_call>")]
+        self.assertEqual(parse_tool_call(body, TOOLS[1]).arguments, EDIT_ARGS)
+        self.assertEqual(parse_tool_call(body).arguments, EDIT_ARGS)       # no schema: </function></tool_call> decides
+
+    def test_streamed_edit_then_bash(self):
+        text = "Go.</think>\n\n" + EDIT_SKIPPED + "\n" + BASH
+        for stream_tools in (False, True):
+            for step in (1, 2, 3, 7, 13, 10_000):
+                with self.subTest(stream_tools=stream_tools, step=step):
+                    evs = run(text, stream_tools=stream_tools, step=step)
+                    self.assertEqual(calls(evs), [("edit_file", EDIT_ARGS), ("bash", BASH_ARGS)])
+                    self.assertFalse([e for e in evs if e.kind == "content" and e.text.strip()])
+                    if stream_tools:
+                        self.assertEqual(streamed(evs), [EDIT_ARGS, BASH_ARGS])
+
+    def test_streamed_edit_alone_at_the_end_of_the_turn(self):
+        text = "Go.</think>\n\n" + EDIT_SKIPPED
+        for stream_tools in (False, True):
+            for step in (1, 3, 10_000):
+                with self.subTest(stream_tools=stream_tools, step=step):
+                    evs = run(text, stream_tools=stream_tools, step=step)
+                    self.assertEqual(calls(evs), [("edit_file", EDIT_ARGS)])
+                    if stream_tools:
+                        self.assertEqual(streamed(evs), [EDIT_ARGS])
+
+    def test_with_recovery_on(self):
+        evs = run("Go.</think>\n\n" + EDIT_SKIPPED + "\n" + BASH, recover=True, step=5)
+        self.assertEqual(calls(evs), [("edit_file", EDIT_ARGS), ("bash", BASH_ARGS)])
+
+
+class SkippedCloserBeforeNextParameter(unittest.TestCase):
+    TEXT = ("<tool_call>\n<function=edit_file>\n<parameter=path>\ntemplates/chat.jinja\n</parameter>\n"
+            "<parameter=old_string>\n<parameter=limit>40</parameter>\n"           # its </parameter> skipped
+            "<parameter=new_string>\n<parameter=limit>25</parameter>\n</parameter>\n</function>\n</tool_call>")
+
+    def test_the_next_declared_parameter_ends_the_value(self):
+        for stream_tools in (False, True):
+            for step in (1, 3, 10_000):
+                with self.subTest(stream_tools=stream_tools, step=step):
+                    evs = run("Go.</think>\n\n" + self.TEXT, stream_tools=stream_tools, step=step)
+                    self.assertEqual(calls(evs), [("edit_file", EDIT_ARGS)])
+                    if stream_tools:
+                        self.assertEqual(streamed(evs), [EDIT_ARGS])
+
+
+class NestedPairsThatAreText(unittest.TestCase):
+    """What must stay the same: matched pairs inside a value, whatever follows them."""
+
+    def test_two_nested_lines_with_a_seen_parameter_name(self):
+        # the first nested closer is followed by `<parameter=limit>` (not a parameter of edit_file) and the value's
+        # own closer by `<parameter=new_string>`: only the latter ends it
+        old = "<parameter=path>README.md</parameter>\n<parameter=limit>40</parameter>"
+        new = "<parameter=path>README.md</parameter>\n<parameter=limit>25</parameter>"
