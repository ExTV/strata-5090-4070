 bool FileExpertSource::copy_from_files(int64_t layer, int64_t expert, uint8_t* dst) const {
     if (dst == nullptr || layer < 0 || expert < 0 || layer >= n_layers_ || expert >= n_expert_) return false;
     if (!role_ptr_.empty()) {
+        // LOCAL (STRATA_BLOB_PREAD=1): read each role slice with pread instead of faulting it through the mapping.
+        // A cold slice then costs one request of `per` bytes instead of a fault (and its 64 KB read-around) per
+        // page when the WILLNEED readahead was dropped under memory pressure; the page cache is still used.
+        static const bool use_pread = [] { const char* v = std::getenv("STRATA_BLOB_PREAD"); return v && v[0] == '1'; }();
         uint64_t at = 0;
         for (int r = 0; r < 3; ++r) {
             const size_t i = (size_t) (3 * layer + r);
             const uint64_t per = role_bytes_[i];
+#if !defined(_WIN32)
+            if (use_pread && role_fd_[i] >= 0) {
+                uint64_t done = 0;
+                const off_t off = (off_t) (role_off_[i] + (uint64_t) expert * per);
+                while (done < per) {
+                    const ssize_t n = ::pread(role_fd_[i], dst + at + done, (size_t) (per - done), off + (off_t) done);
+                    if (n < 0 && errno == EINTR) continue;
+                    if (n <= 0) return false;
+                    done += (uint64_t) n;
+                }
+                at += per;
+                continue;
+            }
+#endif
             std::memcpy(dst + at, role_ptr_[i] + (size_t) ((uint64_t) expert * per), (size_t) per);
             at += per;
         }
