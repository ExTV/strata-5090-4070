+bool MtpDrafter::prepare_chain(std::string& err) {
+    const OnDevice on_device(device_);
+    if (!force_on_ || h_force_ == nullptr) { err = "mtp: chains need set_force_capture before load"; return false; }
+    for (int T = 1; T <= max_t_; ++T)
