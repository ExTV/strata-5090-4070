+def remove_spill_files(cfg: dict) -> int:
+    """--conversation-spill-dir: the engine deletes its spill files when it ends on QUIT; this removes what an engine
+    that was killed or crashed left behind (the server's own stop calls it after the engine is gone).  A relative
+    directory is the engine's (the config's "cwd").  Returns how many files went."""
+    args = [str(x) for x in cfg.get("args") or []]
+    if "--conversation-spill-dir" not in args[:-1]:
+        return 0
+    d = args[args.index("--conversation-spill-dir") + 1]
+    d = d if os.path.isabs(d) else os.path.join(cfg.get("cwd") or ".", d)
+    n = 0
+    for f in glob.glob(os.path.join(glob.escape(d), "spill-*.ses")):
+        try:
+            os.remove(f)
+            n += 1
+        except OSError:
+            pass
+    return n
+
