+
+class SpillCleanup(unittest.TestCase):
+    """--conversation-spill-dir: what a killed engine left behind goes when the server stops; other files stay."""
+
+    def setUp(self):
+        from serve import server
+        self.server = server
+
+    def test_removes_only_the_spill_files(self):
+        with tempfile.TemporaryDirectory() as d:
+            spill = os.path.join(d, "spill")
+            os.mkdir(spill)
+            for n in ("spill-1.ses", "spill-12.ses", "keep.ses", "spill-1.txt"):
+                open(os.path.join(spill, n), "wb").close()
+            cfg = {"cwd": d, "args": ["--pack", "p", "--conversation-spill-dir", "spill"]}
+            self.assertEqual(self.server.remove_spill_files(cfg), 2)
+            self.assertEqual(sorted(os.listdir(spill)), ["keep.ses", "spill-1.txt"])
+
+    def test_no_spill_dir(self):
+        self.assertEqual(self.server.remove_spill_files({"args": ["--conversation-spill-dir"]}), 0)
+        self.assertEqual(self.server.remove_spill_files({}), 0)
+
 if __name__ == "__main__":
     unittest.main()
