+        const float L_next = fmaf(ll[u], w, L);
+        const float acc_next = fmaf(aa[u], w, acc);
+        const bool live = !(mm[u] == -FLT_MAX);   // attn_merge_kernel: `if (m == -FLT_MAX) continue;`
+        L = live ? L_next : L;
+        acc = live ? acc_next : acc;
+    }
