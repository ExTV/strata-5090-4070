+                             us_n = 1000.0 * ms_new / iters;
+                std::printf("%-6s %4d %6d | %10.1f %10.1f %10.1f | %8.1f\n", fmt_name(fmt), n_q, width, us_c, us_o,
+                            us_n, us_o - us_n);
