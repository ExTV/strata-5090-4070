+bool session_copy_layers(SessionState& dst, const SessionState& src, const ModelGeometry& g,
+                         int64_t layer_begin, int64_t layer_end, int src_dev, int dst_dev,
+                         std::string& err, int64_t cell0, int64_t cell1) {
+    // Local port of Strata PR #269 onto the 0.1.33 layer-range carve.  Each session finds its pieces through its own
+    // ordinals and QsaState pointers (the raw block layouts differ).  Streamed K/V: the host copy is the identity
+    // layout [block][kv_head][page][head_dim] (kv_stream.hpp), so a block range is a contiguous run of every array;
+    // VRAM slots are never copied - the receiver's map is evicted from the first rewritten block and its readers
+    // resolve from the host copy, as they do after any miss.  Works in both directions.
+    if (layer_begin >= layer_end) return true;
+    if (cell0 < 0) cell0 = 0;
+    if (cell1 < cell0) cell1 = cell0;
+    int prev_dev = 0;
+    if (cudaGetDevice(&prev_dev) != cudaSuccess) {
+        err = "session_copy_layers: cudaGetDevice failed";
+        return false;
+    }
+    cudaSetDevice(src_dev);
+    cudaDeviceSynchronize();   // the writer's streams must be done with the state being handed off
+    cudaGetLastError();
+    cudaSetDevice(dst_dev);
+    cudaDeviceSynchronize();
+    cudaGetLastError();
+    auto hop = [&](const void* srcp, void* dstp, uint64_t bytes, const char* what) -> bool {
+        if (bytes == 0) return true;
+        if (cudaError_t e = cudaMemcpyPeer(dstp, dst_dev, srcp, src_dev, (size_t) bytes); e != cudaSuccess) {
+            err = std::string("session_copy_layers: peer ") + what + ": " + cudaGetErrorString(e);
+            return false;
+        }
+        return true;
+    };
+    kernels::QsaShapes sh = kernels::qsa_real_shapes();
+    sh.n_head = g.n_head;
+    sh.n_head_kv = g.n_head_kv;
+    sh.head_dim = g.head_dim;
+    sh.idx_n_head = g.idx_q_heads;
+    sh.idx_dim = g.idx_key_dim;
+    const uint64_t gdn_row = gdn_state_floats(g) * 4;
+    bool ok = true;
+    int64_t gdn_ord = 0, qsa_ord = 0;
+    for (int64_t l = 0; l < layer_end && ok; ++l) {
+        const bool mine = l >= layer_begin;
+        if (is_qsa_layer(g, l)) {
+            if (mine) {
+                const QsaState& sq = src.qsa_states[qsa_ord];
+                QsaState& dq = dst.qsa_states[qsa_ord];
+                if (sq.n_slots != dq.n_slots || sq.kv_mode != dq.kv_mode || sq.n_pages != dq.n_pages ||
+                    sq.idx_pooled_rows != dq.idx_pooled_rows) {
+                    err = "session_copy_layers: QSA layouts differ between the sessions";
+                    ok = false;
+                    break;
+                }
+                // the block range [b0, b1): host K/V and the pooled indexer rows (one row per page)
+                const int64_t b0 = std::min<int64_t>(cell0 / sh.page_size, sq.n_pages);
+                const int64_t b1 = std::min<int64_t>((cell1 + sh.page_size - 1) / sh.page_size, sq.n_pages);
+                const uint64_t brows = (uint64_t) sh.n_head_kv * sh.page_size;   // K/V rows per block
+                if (b1 > b0 && sq.kv_mode == 1 && sq.host.present()) {
+                    const uint64_t r0 = (uint64_t) b0 * brows, nr = (uint64_t) (b1 - b0) * brows;
+                    const uint64_t q4_row = kernels::kv_q4_bytes_per_head((int) sh.head_dim);
+                    const uint64_t sc = sh.head_dim / kernels::KV_Q8_GROUP;
+                    if (sq.kv_q4) {
+                        std::memcpy(dq.host.k_q4 + r0 * q4_row, sq.host.k_q4 + r0 * q4_row, nr * q4_row);
+                        std::memcpy(dq.host.v_q4 + r0 * q4_row, sq.host.v_q4 + r0 * q4_row, nr * q4_row);
+                    } else if (sq.kv_int8) {
+                        std::memcpy(dq.host.k_q + r0 * sh.head_dim, sq.host.k_q + r0 * sh.head_dim, nr * sh.head_dim);
+                        std::memcpy(dq.host.v_q + r0 * sh.head_dim, sq.host.v_q + r0 * sh.head_dim, nr * sh.head_dim);
+                        std::memcpy(dq.host.k_scale + r0 * sc, sq.host.k_scale + r0 * sc, nr * sc * 2);
+                        std::memcpy(dq.host.v_scale + r0 * sc, sq.host.v_scale + r0 * sc, nr * sc * 2);
+                    } else {
+                        std::memcpy(dq.host.k_pool + r0 * sh.head_dim, sq.host.k_pool + r0 * sh.head_dim, nr * sh.head_dim * 2);
+                        std::memcpy(dq.host.v_pool + r0 * sh.head_dim, sq.host.v_pool + r0 * sh.head_dim, nr * sh.head_dim * 2);
+                    }
+                } else if (sq.kv_mode != 1) {
+                    // a fully resident layer (no streaming): the VRAM pool is the only copy, whole blocks over the link
+                    const uint8_t* s0 = sq.kv_hybrid || sq.kv_int8 ? (const uint8_t*) sq.k_q
+                                        : sq.kv_q4               ? (const uint8_t*) sq.k_q4
+                                                                 : (const uint8_t*) sq.k_pool;
+                    uint8_t* d0 = dq.kv_hybrid || dq.kv_int8 ? (uint8_t*) dq.k_q
+                                  : dq.kv_q4                 ? (uint8_t*) dq.k_q4
+                                                             : (uint8_t*) dq.k_pool;
+                    ok = hop(s0, d0, (uint64_t) ((const uint8_t*) sq.idx_tail - s0), "qsa pool");
+                }
+                if (ok && b1 > b0) {
+                    const int64_t p0 = std::min<int64_t>(cell0 / sh.idx_block, sq.idx_pooled_rows);
+                    const int64_t p1 = std::min<int64_t>((cell1 + sh.idx_block - 1) / sh.idx_block, sq.idx_pooled_rows);
+                    if (p1 > p0)
+                        ok = hop(sq.idx_pooled + (size_t) p0 * sh.idx_dim, dq.idx_pooled + (size_t) p0 * sh.idx_dim,
+                                 (uint64_t) (p1 - p0) * sh.idx_dim * 4, "indexer rows");
+                }
+                // the indexer's tail and dead row (contiguous), its block position, the step and position records
+                if (ok) ok = hop(sq.idx_tail, dq.idx_tail, (uint64_t) ((const uint8_t*) sq.idx_pooled - (const uint8_t*) sq.idx_tail),
+                                 "indexer tail");
+                if (ok) ok = hop(sq.idx_block_pos, dq.idx_block_pos, 4, "indexer block pos");
+                if (ok) ok = hop(sq.step, dq.step, (uint64_t) ((const uint8_t*) (sq.pos_dev + sh.n_head) - (const uint8_t*) sq.step),
+                                 "qsa step");
+                if (ok) {
+                    std::memcpy(dq.host_step, sq.host_step, kernels::qsa_step_bytes() + sizeof(int32_t));
+                    std::memcpy(dq.host_pos, sq.host_pos, (size_t) sh.n_head * 4);
+                }
+                // the receiver's resident blocks from b0 on hold the old cells: evict them (a whole-state copy resets)
+                if (ok && dq.kv_mode == 1) {
+                    cudaSetDevice(dst_dev);
+                    kernels::kv_stream_evict_from(dq.map, b0, nullptr);
+                    cudaDeviceSynchronize();
+                }
+            }
+            ++qsa_ord;
+        } else {
+            if (mine)
+                ok = hop(src.gdn_state + (size_t) (gdn_ord - src.gdn_ord0) * gdn_state_floats(g),
+                         dst.gdn_state + (size_t) (gdn_ord - dst.gdn_ord0) * gdn_state_floats(g), gdn_row, "gdn state");
+            ++gdn_ord;
+        }
+    }
+    cudaSetDevice(prev_dev);
+    return ok;
+}
